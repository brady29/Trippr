# Copy to .env for local development: cp .env.example .env

# --- API -------------------------------------------------------------------
NODE_ENV=development
PORT=8080
# falkordb (default) or neo4j
DB_DIALECT=falkordb
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=trippr
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=trippr-dev-password

# Signs the API's own tokens (dev sign-in, demo). Use a long random value in production.
APP_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Local sign-in with just a name. Never enable in production.
AUTH_DEV_LOGIN=true
# Read-only demo account on the seeded trip.
DEMO_TRIP_ID=asia-2027
# Clerk (production sign-in): the JWKS URL and issuer from your Clerk instance.
# AUTH_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# AUTH_ISSUER=https://your-instance.clerk.accounts.dev

WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Public address of this API, used in calendar feed links (optional; defaults to the address requests arrive on).
# PUBLIC_API_URL=https://api.example.com
# Fixed token for the seeded owner invite (optional; random when unset).
# SEED_OWNER_INVITE=

# --- Web (Next.js reads NEXT_PUBLIC_* at build time) -----------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Trip inbox (optional). Without a Claude key, pasted links still become activity ideas.
# ANTHROPIC_API_KEY=
# INBOX_MODEL=claude-opus-5-5
# Find the place behind each link (website, tickets, reservations, pin) with Claude's
# web search and web fetch: on or off. Defaults to on when ANTHROPIC_API_KEY is set.
# INBOX_LOOKUP=on
# Postmark inbound address and the secret its webhook sends (?secret=… or basic auth)
# INBOX_EMAIL_ADDRESS=abc123@inbound.postmarkapp.com
# INBOX_WEBHOOK_SECRET=

# Trip assistant (Ask panel): uses ANTHROPIC_API_KEY above. On by default when the key is set;
# ASSISTANT_ENABLED=false switches it off. Questions per member per day (UTC), across trips.
# ASSISTANT_ENABLED=true
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_DAILY_LIMIT=30

# Activity pins: OpenStreetMap's Nominatim (default) or none.
# GEOCODER=nominatim
# GEOCODER_USER_AGENT=Trippr (https://github.com/brady29/Trippr)

# Error reporting (optional): Sentry DSNs for the API and the web app.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Flight prices (optional; docs/flight-prices-provider-spike.md). Off by default.
# FLIGHT_PRICES_ENABLED=true
# travelpayouts needs the token below (a secret: Secret Manager in production); demo serves labelled sample data.
# FLIGHT_PRICES_PROVIDER=travelpayouts
# TRAVELPAYOUTS_TOKEN=
# FLIGHT_PRICES_DAILY_BUDGET=300
# FLIGHT_PRICES_WINDOW_DAYS=3
# FLIGHT_PRICES_MIN_INTERVAL_MS=250
# FLIGHT_PRICES_DROP_PCT=15

# Data load job (pnpm db:load-bundle): where the bundles are, and which trip gets the places.
# BUNDLE_LOCATION=pipelines/out/bundles
# CATALOGUE_TRIP_ID=asia-2027
# EMBEDDINGS_LOCATION=pipelines/out/embeddings

# Semantic search (docs/data-platform.md): the question is embedded by Cloudflare Workers AI when both are set,
# otherwise search matches words only. Keep the token in your shell or this untracked file, never in a tracked one.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# SEARCH_VECTOR_PATH=auto
# SEARCH_RATE_PER_MINUTE=30
# SEARCH_DAILY_LIMIT=150
