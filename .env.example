# Copy to .env for local development: cp .env.example .env

# --- API -------------------------------------------------------------------
NODE_ENV=development
PORT=8080
# falkordb (default) or neo4j
DB_DIALECT=falkordb
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=trippr
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=trippr-dev-password

# Signs the API's own tokens (dev sign-in, demo). Use a long random value in production.
APP_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Local sign-in with just a name. Never enable in production.
AUTH_DEV_LOGIN=true
# Read-only demo account on the seeded trip.
DEMO_TRIP_ID=asia-2027
# Clerk (production sign-in): the JWKS URL and issuer from your Clerk instance.
# AUTH_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# AUTH_ISSUER=https://your-instance.clerk.accounts.dev

WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Fixed token for the seeded owner invite (optional; random when unset).
# SEED_OWNER_INVITE=

# --- Web (Next.js reads NEXT_PUBLIC_* at build time) -----------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Trip inbox (optional). Without a Claude key, pasted links still become activity ideas.
# ANTHROPIC_API_KEY=
# INBOX_MODEL=claude-opus-5-5
# Postmark inbound address and the secret its webhook sends (?secret=… or basic auth)
# INBOX_EMAIL_ADDRESS=abc123@inbound.postmarkapp.com
# INBOX_WEBHOOK_SECRET=

# Error reporting (optional): Sentry DSNs for the API and the web app.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
