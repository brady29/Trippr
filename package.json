{
  "name": "trippr",
  "private": true,
  "version": "0.1.0",
  "description": "Trip Graph: a shared trip planner backed by a graph database.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @trippr/api --filter @trippr/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r --filter @trippr/rules --filter @trippr/contracts --filter @trippr/web test",
    "test:integration": "pnpm --filter @trippr/api test:integration",
    "test:e2e": "pnpm --filter @trippr/web test:e2e",
    "db:up": "docker compose up -d falkordb",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "db:export": "tsx scripts/export.ts",
    "db:backup": "pnpm --filter @trippr/api backup",
    "db:restore": "tsx --env-file-if-exists=.env scripts/restore.ts",
    "flights:snapshot": "pnpm --filter @trippr/api flights:snapshot",
    "db:load-bundle": "pnpm --filter @trippr/api load-bundle",
    "eval:search": "pnpm --filter @trippr/api eval-search",
    "eval:recommend": "pnpm --filter @trippr/api eval-recommend",
    "eval:inbox": "tsx --env-file-if-exists=.env scripts/eval-inbox.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@trippr/api": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.19.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "3.2.7"
  }
}
