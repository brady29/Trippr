{
  "name": "@trippr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db/index.ts",
    "./config": "./src/config.ts",
    "./seed": "./src/db/seed.ts",
    "./inbox-eval": "./src/services/inbox/eval-kit.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "flights:snapshot": "tsx --env-file-if-exists=../../.env src/flight-snapshots.ts",
    "load-bundle": "tsx --env-file-if-exists=../../.env src/load-bundle.ts",
    "eval-search": "tsx --env-file-if-exists=../../.env src/eval-search.ts",
    "eval-recommend": "tsx src/eval-recommend.ts",
    "fake-embeddings": "tsx src/fake-embeddings.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@fastify/cors": "10.0.2",
    "@google-cloud/storage": "7.16.0",
    "@sentry/node": "10.78.0",
    "@trippr/contracts": "workspace:^",
    "@trippr/rules": "workspace:^",
    "falkordb": "6.9.3",
    "fastify": "5.2.1",
    "jose": "5.9.6",
    "neo4j-driver": "5.27.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsup": "8.3.6"
  }
}
