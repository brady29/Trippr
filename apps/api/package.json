{
  "name": "@trippr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db/index.ts",
    "./config": "./src/config.ts",
    "./seed": "./src/db/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@trippr/contracts": "workspace:^",
    "@trippr/rules": "workspace:^",
    "falkordb": "6.9.3",
    "fastify": "5.2.1",
    "jose": "5.9.6",
    "neo4j-driver": "5.27.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "tsup": "8.3.6"
  }
}
