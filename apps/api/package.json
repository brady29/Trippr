    "@trippr/rules": "workspace:^",
    "falkordb": "6.9.3",
    "fastify": "5.12.8",
    "jose": "5.10.0",
    "neo4j-driver": "5.28.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsup": "8.5.1"
